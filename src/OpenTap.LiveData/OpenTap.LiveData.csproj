<Project Sdk="Microsoft.NET.Sdk">
  <!--
    OpenTap.LiveData: the public SDK for live device data. It holds only the attributes [LiveData] and [DeviceFunction]
    and references nothing but .NET (netstandard2.0). A host that shows live data (Tap.X) finds the attributes by their
    full name; where no such host is installed they do nothing. OpenTAP is referenced for packaging only (no assembly).
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>OpenTap.LiveData</AssemblyName>
    <RootNamespace>OpenTap.LiveData</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <OutputPath>$(MSBuildThisFileDirectory)..\..\bin\$(Configuration)\</OutputPath>
    <OpenTapPackageDefinitionPath>package.xml</OpenTapPackageDefinitionPath>
    <CreateOpenTapPackage>false</CreateOpenTapPackage>
    <InstallCreatedOpenTapPackage>false</InstallCreatedOpenTapPackage>

    <PackageId>OpenTap.LiveData</PackageId>
    <Authors>MCF Technologie GmbH</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/MCF-Technologie-GmbH/opentap-livedata</RepositoryUrl>
    <Description>Attributes for live device data in OpenTAP drivers: mark properties with [LiveData] and operator functions with [DeviceFunction]. A host such as Tap.X shows them live; without one they do nothing.</Description>
    <PackageTags>OpenTAP;live data;instruments</PackageTags>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <CreateOpenTapPackage>true</CreateOpenTapPackage>
  </PropertyGroup>
  <ItemGroup>
    <!-- the OpenTAP package build only: no compile-time or run-time reference -->
    <PackageReference Include="OpenTAP" Version="$(OpenTapVersion)" ExcludeAssets="compile;runtime" PrivateAssets="all" />
  </ItemGroup>
</Project>
